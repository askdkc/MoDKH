{
  "name": "modkh",
  "version": "0.1.0",
  "description": "MoDKH — Common Lispで担当を定義できるコーディングハーネス",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0"
  },
  "bin": {
    "modkh": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "plugins",
    "skills",
    "experiments/presets",
    "native/stateright/Cargo.toml",
    "native/stateright/Cargo.lock",
    "native/stateright/src"
  ],
  "exports": {
    "./plugin-api": {
      "types": "./dist/plugins/api.d.ts",
      "default": "./dist/plugins/api.js"
    }
  },
  "scripts": {
    "build:stateright": "cargo build --locked --manifest-path native/stateright/Cargo.toml",
    "pretest": "npm run build:stateright",
    "test:stateright": "cargo test --locked --manifest-path native/stateright/Cargo.toml && node --test test/stateright*.test.ts test/formal.tools.test.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-grammars.mjs && node scripts/verify-bundled-skills.mjs",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "node --test --test-reporter=tap \"test/*.test.ts\" \"test/*.test.mjs\""
  },
  "keywords": [
    "cli",
    "coding-agent"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "ai": "^7.0.163",
    "marked": "^18.2.1",
    "undici": "^7.29.1",
    "vscode-jsonrpc": "^10.0.0",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.9.3"
  }
}
